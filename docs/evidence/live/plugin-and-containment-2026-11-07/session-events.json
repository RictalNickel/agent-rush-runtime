                    "content": "import csv\nimport io\n\n\ndef totals_by_region(csv_text):\n    \"\"\"Return a dict mapping region -> summed amount from CSV text.\n\n    Expects a header row with 'region' and 'amount' columns.\n    Malformed rows (wrong column count or non-numeric amount) are skipped.\n    \"\"\"\n    totals = {}\n    reader = csv.DictReader(io.StringIO(csv_text))\n    for row in reader:\n        region = (row.get(\"region\") or \"\").strip()\n        amount_raw = (row.get(\"amount\") or \"\").strip()\n        if not region or not amount_raw:\n            continue\n        try:\n            amount = float(amount_raw)\n        except ValueError:\n            continue\n        totals[region] = totals.get(region, 0.0) + amount\n    return totals\n",
                    "path": "/workspace/sales/sales.py",
                    "tool": "write_file"
                },
                "tool": "write_file"
