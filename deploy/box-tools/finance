#!/usr/bin/python3 -I
"""Run the installed Finance Lab environment without workspace imports."""
import os
import sys
from pathlib import Path

runtime = Path("/opt/finance")
python = runtime / "venv/bin/python"
if not python.is_file():
    python = Path("/usr/bin/python3")
os.environ["BOXORO_FINANCE_WORKSPACE"] = "/workspace"
os.environ["PYTHONNOUSERSITE"] = "1"
os.execv(str(python), [str(python), "-I", str(runtime / "cli.py"), *sys.argv[1:]])
