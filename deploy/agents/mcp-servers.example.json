{
  "servers": [
    {
      "name": "github-readonly",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_SCOPED_GITHUB_TOKEN",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,pull_requests,actions"
      },
      "allowed_tools": [
        "get_file_contents",
        "list_branches",
        "list_commits",
        "get_commit",
        "search_repositories",
        "pull_request_read"
      ]
    },
    {
      "name": "finance-openbb",
      "url": "http://127.0.0.1:8768/mcp",
      "headers": {
        "Authorization": "Bearer REPLACE_WITH_FINANCE_OPENBB_TOKEN"
      },
      "allowed_tools": [
        "openbb_status",
        "openbb_catalog",
        "openbb_describe",
        "openbb_query"
      ]
    }
  ]
}
