# Fill values through the trusted deployment runner. Store the real file mode 0600.
AR_BIND=127.0.0.1:8080
AR_DATA_DIR=/var/lib/agent-rush/control
AR_SECURE_COOKIES=true
AR_CAPACITY_MB=6144
AR_OPERATOR_PASSWORD=
AR_WORKER_URL=https://worker.agent-rush.internal:8443
AR_WORKER_TOKEN=
AR_WORKER_CA_PATH=/etc/agent-rush/tls/ca.crt
AR_WORKER_IDENTITY_PATH=/etc/agent-rush/tls/control-client.pem
# Inference provider for every agent role: vultr (default; required by the Blast Radius
# Zero track) or anthropic (the Claude team in docs/AGENT_TEAM.md).
AR_INFERENCE_PROVIDER=vultr
# Only for AR_INFERENCE_PROVIDER=anthropic. Calls are priced from Anthropic list prices.
ANTHROPIC_API_KEY=
VULTR_INFERENCE_API_KEY=
# Selected: GLM 5.3 Flash. Its Vultr catalog ID is glm-5.3-flash.
AR_INFERENCE_MODEL=glm-5.3-flash
# Provider tariffs from Vultr's model catalog (GET /v1/models, per-token cost_usd x 1e6),
# checked 2026-11-05. Re-check before use; empty values keep inference disabled.
AR_INPUT_USD_PER_MILLION=0.10
AR_OUTPUT_USD_PER_MILLION=0.35
# Optional: models a session may choose, id:input:output in USD per million tokens, from the
# same catalog. AR_INFERENCE_MODEL must be one of them. Unset: every session runs the default.
#AR_INFERENCE_MODELS=glm-5.3-flash:0.10:0.35,glm-5.3:0.75:3.00
AR_PRICING_VERIFIED=true
# Hard cap on recorded model spend, at most 25.
AR_INFERENCE_BUDGET_USD=5
