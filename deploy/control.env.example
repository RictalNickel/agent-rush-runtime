# Fill values through the trusted deployment runner. Store the real file mode 0600.
AR_BIND=127.0.0.1:8080
AR_DATA_DIR=/var/lib/agent-rush/control
AR_SECURE_COOKIES=true
AR_CAPACITY_MB=6144
AR_OPERATOR_PASSWORD=
AR_WORKER_URL=https://worker.agent-rush.internal:8443
AR_WORKER_TOKEN=
AR_WORKER_CA_PATH=/etc/agent-rush/tls/ca.crt
AR_WORKER_IDENTITY_PATH=/etc/agent-rush/tls/control-client.pem
VULTR_INFERENCE_API_KEY=
# Selected: GLM 5.3 Flash. Fill only its verified Vultr catalog ID.
AR_INFERENCE_MODEL=
# Internal provider tariffs, filled by setup from verified Vultr rates. User need not choose them.
# Empty/unset means unverified; inference stays disabled rather than assuming a zero price.
AR_INPUT_USD_PER_MILLION=
AR_OUTPUT_USD_PER_MILLION=
# Setup sets true only after validating the selected model's official tariff and units.
AR_PRICING_VERIFIED=false
AR_INFERENCE_BUDGET_USD=5
