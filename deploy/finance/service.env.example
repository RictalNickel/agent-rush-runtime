# Private control-host Compose --env-file; never copy into an agent workspace.
# Replace image with the built finance-service image digest and file paths.
FINANCE_OPENBB_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST
FINANCE_OPENBB_TOKEN_FILE=/etc/boxoro-finance/token
FINANCE_OPENBB_STATE_DIR=/var/lib/boxoro-finance
# Optional credentials: empty fields leave that source unconfigured.
FRED_API_KEY=
EIA_API_KEY=
BLS_API_KEY=
CFTC_APP_TOKEN=
CONGRESS_GOV_API_KEY=
