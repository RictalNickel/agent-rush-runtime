# Worker must never receive the Vultr infrastructure or inference credential.
AR_DATA_DIR=/var/lib/agent-rush/worker
AR_CAPACITY_MB=6144
# Actual admission is clamped to physical memory minus 25% (at least 256 MiB).
AR_QUALIFICATION_REPORT=/var/lib/agent-rush/qualification.json
AR_WORKER_TOKEN=
AR_SANDBOX_IMAGE=rust:1.90.0-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
# Session boxes; install-worker.sh sets AR_BOX_IMAGE to the digest it built.
AR_BOX_IMAGE=
AR_BOX_QUALIFICATION_REPORT=/var/lib/agent-rush/box-qualification.json
AR_BOX_IDLE_SECONDS=1800
AR_BOX_CEILING_MB=4096
# Boxes this worker runs at once (memory capacity still applies). Raise on larger hosts.
AR_BOX_MAX=8
# Each box's /workspace is a sparse ext4 image of this size (MiB): writes past it fail with
# ENOSPC. Box creation is refused unless the data disk keeps 2x this plus 2 GiB free after
# every existing workspace's possible growth.
AR_BOX_DISK_MB=4096
# An idle box (AR_BOX_IDLE_SECONDS) is parked: container removed, workspace kept, restarted
# on the next call. A parked workspace is deleted after this long without a call (7 days).
AR_BOX_RETENTION_SECONDS=604800
# Private ip:port endpoints the host reaches and boxes must not (comma list), probed by
# requalify-box.sh; install-worker.sh sets the control VM's SSH.
AR_BOX_PRIVATE_PROBES=
