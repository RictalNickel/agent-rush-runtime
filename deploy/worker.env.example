# Worker must never receive the Vultr infrastructure or inference credential.
AR_DATA_DIR=/var/lib/agent-rush/worker
AR_CAPACITY_MB=6144
# Actual admission is clamped to physical memory minus 25% (at least 256 MiB).
AR_QUALIFICATION_REPORT=/var/lib/agent-rush/qualification.json
AR_WORKER_TOKEN=
AR_SANDBOX_IMAGE=rust:1.90.0-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
