[Unit]
Description=Boxoro Rust control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-rush
Group=agent-rush
EnvironmentFile=/etc/agent-rush/control.env
ExecStart=/opt/agent-rush/agent-rush serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-rush
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
