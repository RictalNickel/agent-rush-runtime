      "tools": [
        "promptfoo",
        "garak",
        "giskard",
        "pyrit"
      ]
    },
    {
      "id": "policy-report",
      "description": "Normalized evidence, compliance and policy enforcement",
      "tools": [
        "opa",
        "conftest",
        "sarif",
        "cyclonedx-cli",
        "oscal"
      ]
    }
  ]
}
